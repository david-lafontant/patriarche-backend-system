<p style="color: green"><%= notice %></p>
<%= link_to "New article", new_article_path, class: "btn btn-primary d.block" %>
<h1>Articles</h1>
<div id="articles">
  <% @articles.each do |article| %>
    <h2><%= article.title %></h2>
    <p>
      <strong>Subltitle:</strong>
      <%= article.subltitle %>
    </p>
    <% if article.contents.attached?  %>
      <%if article.contents[0].image?%>
        <figure>
          <%= image_tag(article.contents[0], class: "image", alt: "Card image cap") %>
          <figcaption><%= article.description %></figcaption>
        </figure>
      <%end%>
    <%end%>
    <p><%= article.description%></p>
    <p>
      <%= link_to "Show this article", article %>
    </p>
  <% end %>
</div>

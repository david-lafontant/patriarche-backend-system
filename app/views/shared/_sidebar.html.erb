<div class="flex-shrink-0 p-3" style="width: 280px;">
  <a href="/" class="d-flex align-items-center pb-3 mb-3 link-body-emphasis text-decoration-none border-bottom">
    <svg class="bi pe-none me-2" width="30" height="24"><use xlink:href="#bootstrap"/></svg>
    <span class="fs-5 fw-semibold">Back Office</span>
    %>
    <ul class="list-unstyled ps-0">
      <li class="mb-1">
        <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed" data-bs-toggle="collapse" data-bs-target="#home-collapse" aria-expanded="true">
          Articles
        </button>
        <div class="collapse show" id="home-collapse">
          <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
            <li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Articles %></li>
            <li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Creer un article %></li>
            <li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Modifier un article %></li>
          </ul>
        </div>
      </li>
      <li class="mb-1">
        <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed" data-bs-toggle="collapse" data-bs-target="#dashboard-collapse" aria-expanded="false">
          Emissions
        </button>
        <div class="collapse" id="dashboard-collapse">
          <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
            <li><%=  link_to "Emissions" , articles_path, class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %></li>
            <li><%=  link_to "Creer une emission" , new_article_path, class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %></li>
            <li><%=  link_to "Modifier une emission" , edit_article_path, class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %></li>
            <!--<li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Annually %></li>-->
          </ul>
        </div>
      </li>
      <li class="mb-1">
        <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed" data-bs-toggle="collapse" data-bs-target="#orders-collapse" aria-expanded="false">
          Media (Contenus)
        </button>
        <div class="collapse" id="orders-collapse">
          <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
            <li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Media %></li>
            <li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Ajouter un media %></li>
            <!--<li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Shipped %></li>-->
            <!--<li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Returned %></li>-->
          </ul>
        </div>
      </li>
      <li class="border-top my-3"></li>
      <li class="mb-1">
        <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed" data-bs-toggle="collapse" data-bs-target="#account-collapse" aria-expanded="false">
          Utilisateur
        </button>
        <div class="collapse" id="account-collapse">
          <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
            <!--<li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">New... %></li>-->
            <li><%=  link_to "Profile", articles_path, class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %></li>
            <li><%=  link_to "Settings", article_path,  class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %></li>
            <!--<li><%=  link_to "" , class: "link-body-emphasis d-inline-flex text-decoration-none rounded">Sign out %></li>-->
            <li>
              <% if user_signed_in? %>
                <%= link_to "Signout", destroy_user_session_path, data: {turbo_method: :delete}, class: "link-body-emphasis d-inline-flex text-decoration-none rounded" %>
              <% else %>
                <%= link_to('login', new_user_session_path, class: "link-body-emphasis d-inline-flex text-decoration-none rounded") %>
              <% end %>
            </li>
          </ul>
        </div>
      </li>
    </ul>
  </div>